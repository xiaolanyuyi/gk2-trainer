<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Minimal BepInEx 5 plugin for Graveyard Keeper 2.

    It does three things:
      1. writes a state snapshot (money / resources / hp / day) to state.json
      2. reads command.json and applies operations through the game's own API
      3. keeps a small log.txt for diagnosis

    That is the whole "game side" of the trainer; the desktop app talks to it
    through those files (see docs/recon.md and the game-trainer skill).

    Build:
        dotnet build src\GK2Trainer.App\GK2Trainer.App.csproj
    The plugin dll has to be built first (it is embedded below).
  -->

  <PropertyGroup>
    <!-- Unity 6000 assemblies are built against netstandard 2.1. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2Trainer.Plugin</AssemblyName>
    <RootNamespace>GK2Trainer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 游戏目录必须由外部指定（仓库里不含任何硬编码路径）：
           dotnet build plugin\GK2Trainer.Plugin.csproj -p:GameDir="<...>\Graveyard Keeper 2"
         或直接用 tools\deploy.ps1 / tools\publish.ps1 —— 它们会自动探测游戏目录。 -->
    <ManagedDir>$(GameDir)\GraveyardKeeper2_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <Target Name="EnsureGameDir" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameDir)' == ''"
           Text="请指定游戏目录：-p:GameDir=&quot;...\Graveyard Keeper 2&quot;（或使用 tools\deploy.ps1 自动探测）" />
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="在 $(GameDir) 下找不到 GraveyardKeeper2_Data\Managed\Assembly-CSharp.dll，请确认路径。" />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's own code: no reflection needed, the trainer calls real methods. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GameResSystemBase and friends live in the engine-agnostic LazyBear layer. -->
    <Reference Include="LazyBearTechnology">
      <HintPath>$(ManagedDir)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Facade assembly: BepInEx's BaseUnityPlugin derives from MonoBehaviour,
         which Unity type-forwards through UnityEngine.dll. -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Ships with the game, so the plugin needs no extra dependency. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
